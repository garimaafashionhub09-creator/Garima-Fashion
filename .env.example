# Frontend Configuration

# API URL — Backend server endpoint
# Development: http://localhost:5000/api
# Production:  https://garima-fashion-backend.onrender.com/api  ← update after Render deploy
VITE_API_URL=http://localhost:5000/api

# Cloudinary Configuration (Required for image display and transformations)
# Sign up at https://cloudinary.com to get your cloud name from the dashboard

# VITE_CLOUDINARY_CLOUD_NAME: Your Cloudinary cloud name
# Used to: Construct optimized image URLs with transformations for display
# Must match: The CLOUDINARY_CLOUD_NAME value in your backend .env file
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
