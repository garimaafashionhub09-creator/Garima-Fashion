# Server Configuration
PORT=5000
BACKEND_URL=http://localhost:5000

# Database
MONGODB_URI=your-mongodb-connection-string

# JWT Secret (Generate a strong random string)
JWT_SECRET=your-jwt-secret-key

# Admin Credentials (DO NOT commit real credentials)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Cloudinary Configuration (Required for image uploads and management)
# Sign up at https://cloudinary.com to get these credentials from your dashboard
# Used for: secure image upload signature generation, image deletion, and API operations

# CLOUDINARY_CLOUD_NAME: Your Cloudinary cloud name (found in dashboard)
# Used to: Identify your Cloudinary account and construct image URLs
# Example: "my-cloud-name" (do not include the full domain)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# CLOUDINARY_API_KEY: Your Cloudinary API key (found in dashboard)
# Used to: Authenticate API requests to Cloudinary
# Note: This is included in signed upload requests to the frontend
CLOUDINARY_API_KEY=your-cloudinary-api-key

# CLOUDINARY_API_SECRET: Your Cloudinary API secret (found in dashboard)
# Used to: Generate signed upload signatures and authenticate admin operations
# CRITICAL: Keep this secret! Never expose to frontend or commit to version control
# Used for: Signing upload requests, deleting images, and other admin operations
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Upload Configuration:
# - Images are uploaded to folder: "garima-fashion/products"
# - Signature expiration: 3600 seconds (1 hour)
# - Max file size: 10 MB (10,485,760 bytes)
# - Allowed formats: JPEG, PNG, WebP, GIF
# - Max images per product: 10

# CORS Configuration (Required for production — comma-separated list of allowed origins)
# Set this in your Render environment variables dashboard
# Example: https://garima-fashion.vercel.app,https://www.garimafashion.com
# CORS_ORIGIN=https://your-vercel-app.vercel.app

# Backend URL (update to your Render URL in production)
# BACKEND_URL=https://garima-fashion-backend.onrender.com
